PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/solace
JWT_SECRET=change-me-to-a-long-random-string
# Claude API key. Without it, Sol falls back to a built-in empathetic responder.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Free Groq key (https://console.groq.com/keys): fast replies + accurate voice transcription.
GROQ_API_KEY=
